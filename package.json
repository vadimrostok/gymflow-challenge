{
  "name": "gymflow-challenge",
  "main": "index.js",
  "version": "1.0.0",
  "scripts": {
    "start": "expo start",
    "android": "expo run:android",
    "ios": "expo run:ios",
    "web": "expo start --web",
    "lint": "expo lint",
    "test": "jest --watchAll=false",
    "test:watch": "jest --watch",
    "e2e:web": "npm run web",
    "e2e:ios:build": "detox build --configuration ios.sim.debug",
    "e2e:ios": "npm run e2e:ios:build && detox test --configuration ios.sim.debug --cleanup",
    "e2e:android": "detox test --configuration android.emu.debug --cleanup",
    "e2e:full": "npm run e2e:web && npm run e2e:mobile",
    "e2e:mobile": "npm run e2e:ios && npm run e2e:android",
    "e2e:mobile:watch": "npm run e2e:ios:build && detox test --configuration ios.sim.debug -- --watch --runInBand"
  },
  "dependencies": {
    "@expo/metro-runtime": "~6.1.2",
    "@expo/vector-icons": "^15.0.3",
    "@hookform/resolvers": "^5.2.2",
    "@react-native-picker/picker": "^2.11.4",
    "@react-navigation/bottom-tabs": "^7.4.0",
    "@react-navigation/elements": "^2.6.3",
    "@react-navigation/native": "^7.1.8",
    "@supabase/supabase-js": "^2.105.4",
    "expo": "~54.0.33",
    "expo-constants": "~18.0.13",
    "expo-font": "~14.0.11",
    "expo-haptics": "~15.0.8",
    "expo-image": "~3.0.11",
    "expo-linking": "~8.0.11",
    "expo-router": "~6.0.23",
    "expo-splash-screen": "~31.0.13",
    "expo-sqlite": "^16.0.10",
    "expo-status-bar": "~3.0.9",
    "expo-symbols": "~1.0.8",
    "expo-system-ui": "~6.0.9",
    "expo-web-browser": "~15.0.10",
    "luxon": "^3.7.2",
    "mobx": "^6.15.3",
    "mobx-react-lite": "^4.1.1",
    "motion": "^12.38.0",
    "nativewind": "^4.2.3",
    "react": "19.1.0",
    "react-dom": "19.1.0",
    "react-hook-form": "^7.75.0",
    "react-native": "0.81.5",
    "react-native-gesture-handler": "~2.28.0",
    "react-native-reanimated": "~4.1.1",
    "react-native-safe-area-context": "~5.6.0",
    "react-native-screens": "~4.16.0",
    "react-native-ui-datepicker": "^3.1.3",
    "react-native-web": "^0.21.2",
    "react-native-worklets": "0.5.1",
    "react-router-dom": "^6.30.3",
    "reanimated": "^0.0.1-alpha",
    "zod": "^4.4.3"
  },
  "devDependencies": {
    "@testing-library/react-native": "^13.3.3",
    "@types/detox": "^17.14.3",
    "@types/jest": "^29.5.14",
    "@types/luxon": "^3.7.1",
    "@types/react": "~19.1.0",
    "@types/react-native": "^0.72.8",
    "@types/react-native-web": "^0.19.2",
    "@types/react-test-renderer": "^19.1.0",
    "detox": "^20.50.4",
    "eslint": "^9.25.0",
    "eslint-config-expo": "~10.0.0",
    "jest": "^29.7.0",
    "jest-expo": "^54.0.17",
    "playwright": "^1.60.0",
    "prettier-plugin-tailwindcss": "^0.5.14",
    "react-native-dotenv": "^3.4.11",
    "react-test-renderer": "19.1.0",
    "tailwindcss": "^3.4.19",
    "typescript": "~5.9.2"
  },
  "private": true
}
